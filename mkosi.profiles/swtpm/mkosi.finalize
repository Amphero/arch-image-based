#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# The unit ordering fixes have to work in the initrd too, that's where
# the unlocking happens. mkosi has no config knob to add extra files to
# the default initrd, but it picks up any cpio dropped into
# $ARTIFACTDIR/io.mkosi.initrd and appends it to the initrd, where later
# entries win. So pack the extra tree as a small cpio.
set -euo pipefail

mkdir -p "$ARTIFACTDIR/io.mkosi.initrd"
cd "$SRCDIR/mkosi.profiles/swtpm/mkosi.extra"
find usr etc -type f -o -type d | cpio -o -H newc --quiet \
    > "$ARTIFACTDIR/io.mkosi.initrd/50-swtpm-units.cpio"
