# Rebuilds the image from the frozen checkout in /var/lib/builder with
# current packages and stages it via sysupdate. Activation happens on
# the next regular reboot, a failed boot falls back automatically (boot
# counting). Does nothing until scripts/builder-setup.sh was run once.
[Unit]
Description=Weekly Image Rebuild
After=network-online.target
Wants=network-online.target
ConditionACPower=true
ConditionPathExists=/var/lib/builder/arch-image-based/mkosi.conf
OnSuccess=image-rebuild-notify.service

[Service]
Type=oneshot
WorkingDirectory=/var/lib/builder/arch-image-based
# Without a sleep inhibitor the idle suspend of the GDM greeter (or of a
# locked session) cuts the build off after a few minutes.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --mode=block --who=image-rebuild --why="Building and installing a new image" /usr/bin/mkosi -B -ff sysupdate -- update
ExecStartPost=/usr/bin/find /var/lib/builder/cache -type f -mtime +28 -delete
TimeoutStartSec=3h
Nice=10
CPUWeight=20
IOWeight=20
