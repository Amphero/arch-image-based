#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -e

if command -v authselect >/dev/null; then
    authselect select local
    authselect enable-feature with-systemd-homed
fi

if [[ -d /etc/pam.d ]]; then
    find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
    rmdir /etc/pam.d
fi

# Get rid of obsolete stuff in the pam stack.
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_shells.so/d' {} \;
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_securetty.so/d' {} \;

# Fedora disables the userdb ssh dropin by default, but helpfully leaves it available in
# the package so that we can just symlink it to a name that will be picked up by systemd-tmpfiles.
if [[ -f /usr/lib/tmpfiles.d/20-systemd-userdb.conf.example ]]; then
    ln --symbolic 20-systemd-userdb.conf.example /usr/lib/tmpfiles.d/20-systemd-userdb.conf
fi

# Locales have to be compiled into /usr at build time, locale-gen
# cannot write to the read-only /usr on the installed system. The
# default LANG lives in /usr/share/factory/etc/locale.conf.
if command -v locale-gen >/dev/null; then
    printf '%s\n' 'de_DE.UTF-8 UTF-8' 'en_US.UTF-8 UTF-8' >/etc/locale.gen
    locale-gen
fi

# No extra branding: this is plain Arch Linux, packaged as an image.
# The distro's own os-release stays in place.

# Tie system extensions to this exact image. systemd matches an
# extension by ID= plus SYSEXT_LEVEL=, and Arch has no VERSION_ID= to
# match on, so publish the image version as the level. An extension
# built for another image then simply does not load, which is what we
# want on a rollback.
if [[ -n "${IMAGE_VERSION:-}" ]]; then
    echo "SYSEXT_LEVEL=$IMAGE_VERSION" >>/usr/lib/os-release
fi
