#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Builds evdi against the kernel of the base image and installs the
# DisplayLink manager, mirroring the AUR displaylink and evdi packages.
# Everything runs in the chroot: the toolchain lives in the buildroot,
# not in the base tree the script itself sees.
set -euo pipefail

cp "$SRCDIR"/files/* "$BUILDROOT/tmp/"
cat >"$BUILDROOT/tmp/build-evdi.sh" <<'EOF'
set -euo pipefail

evdi_ver=1.14.10
evdi_sha=9fc0165d02e88507135d6a67ccaa06f7b5cd651e375394a1674d5ea4ec7a00aa
dl_ver=6.3
dl_fullver=6.3.0-48
dl_date=2026-06
dl_sha=7269856c7527060c513215ce1b5a36fef074d8e89cab89bcab13df342acce098

# The kernel of the image and the headers from the repo must match,
# otherwise the module is useless on the target.
set -- /usr/lib/modules/*/vmlinuz
kver=$(basename "$(dirname "$1")")
if [ ! -d "/usr/lib/modules/$kver/build" ]; then
    echo "no headers for the kernel in the base image ($kver), the repo" >&2
    echo "has $(pacman -Q linux-headers 2>/dev/null || echo none)" >&2
    echo "rebuild image and sysext from the same snapshot (builder flow)" >&2
    exit 1
fi

cd "$(mktemp -d)"

# evdi: kernel module and userspace library
curl -fsSL -o evdi.tar.gz "https://github.com/DisplayLink/evdi/archive/v$evdi_ver/evdi-$evdi_ver.tar.gz"
echo "$evdi_sha  evdi.tar.gz" | sha256sum -c -
tar xf evdi.tar.gz
# No DKMS_BUILD here: the Makefile treats any non-empty value, even 0,
# as "use the dkms branch".
make -C "evdi-$evdi_ver/module" KVER="$kver"
make -C "evdi-$evdi_ver/library"
install -Dm644 "evdi-$evdi_ver/module/evdi.ko" "/usr/lib/modules/$kver/extra/evdi.ko"
install -Dm755 "evdi-$evdi_ver/library/libevdi.so" /usr/lib/libevdi.so

# DisplayLink manager and firmware from the vendor zip
curl -fsSL -o dl.zip "https://www.synaptics.com/sites/default/files/exe_files/$dl_date/DisplayLink%20USB%20Graphics%20Software%20for%20Ubuntu$dl_ver-EXE.zip"
echo "$dl_sha  dl.zip" | sha256sum -c -
unzip -q dl.zip
chmod +x "displaylink-driver-$dl_fullver.run"
"./displaylink-driver-$dl_fullver.run" --noexec --target driver --nox11 --noprogress
install -Dm755 driver/x64-ubuntu-1604/DisplayLinkManager /usr/lib/displaylink/DisplayLinkManager
install -Dm644 driver/*.spkg -t /usr/lib/displaylink
install -Dm644 driver/LICENSE /usr/share/licenses/displaylink/LICENSE

# service, udev rule and sleep hook as shipped by the AUR package
install -Dm644 /tmp/99-displaylink.rules /usr/lib/udev/rules.d/99-displaylink.rules
install -Dm755 /tmp/udev.sh /opt/displaylink/udev.sh
install -Dm644 /tmp/displaylink.service /usr/lib/systemd/system/displaylink.service
install -Dm755 /tmp/displaylink-sleep.sh /usr/lib/systemd/system-sleep/displaylink.sh

# Regenerate the module index so modprobe finds evdi. This runs on the
# merged tree, so the new index covers the base modules as well.
depmod -a "$kver"
EOF

mkosi-chroot bash /tmp/build-evdi.sh
rm -f "$BUILDROOT"/tmp/build-evdi.sh "$BUILDROOT"/tmp/{udev.sh,99-displaylink.rules,displaylink.service,displaylink-sleep.sh}
