#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Sources and checksums track the AUR displaylink and evdi packages.
set -euo pipefail

evdi_ver=1.14.10
evdi_sha=9fc0165d02e88507135d6a67ccaa06f7b5cd651e375394a1674d5ea4ec7a00aa
dl_ver=6.3
dl_fullver=6.3.0-48
dl_date=2026-06
dl_sha=7269856c7527060c513215ce1b5a36fef074d8e89cab89bcab13df342acce098

# The base image kernel (has vmlinuz) must match the linux-headers we
# compile against, otherwise the module is useless on the target.
set -- /usr/lib/modules/*/vmlinuz
kimg=$(basename "$(dirname "$1")")
set -- /usr/lib/modules/*/build
khdr=$(basename "$(dirname "$1")")
if [ "$kimg" != "$khdr" ]; then
    echo "kernel mismatch: base image has $kimg, linux-headers has $khdr" >&2
    echo "rebuild image and sysext from the same snapshot (builder flow)" >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd "$work"

# evdi: kernel module and userspace library
curl -fsSL -o evdi.tar.gz "https://github.com/DisplayLink/evdi/archive/v$evdi_ver/evdi-$evdi_ver.tar.gz"
echo "$evdi_sha  evdi.tar.gz" | sha256sum -c -
tar xf evdi.tar.gz
# No DKMS_BUILD here: the Makefile treats any non-empty value, even 0,
# as "use the dkms branch".
make -C "evdi-$evdi_ver/module" KVER="$khdr"
make -C "evdi-$evdi_ver/library"
install -Dm644 "evdi-$evdi_ver/module/evdi.ko" "$DESTDIR/usr/lib/modules/$kimg/extra/evdi.ko"
install -Dm755 "evdi-$evdi_ver/library/libevdi.so" "$DESTDIR/usr/lib/libevdi.so"

# DisplayLink manager and firmware from the vendor zip
curl -fsSL -o dl.zip "https://www.synaptics.com/sites/default/files/exe_files/$dl_date/DisplayLink%20USB%20Graphics%20Software%20for%20Ubuntu$dl_ver-EXE.zip"
echo "$dl_sha  dl.zip" | sha256sum -c -
unzip -q dl.zip
chmod +x "displaylink-driver-$dl_fullver.run"
"./displaylink-driver-$dl_fullver.run" --noexec --target driver --nox11 --noprogress
install -Dm755 driver/x64-ubuntu-1604/DisplayLinkManager "$DESTDIR/usr/lib/displaylink/DisplayLinkManager"
install -Dm644 driver/*.spkg -t "$DESTDIR/usr/lib/displaylink"
install -Dm644 driver/LICENSE "$DESTDIR/usr/share/licenses/displaylink/LICENSE"

# service, udev rule and sleep hook as shipped by the AUR package
install -Dm644 "$SRCDIR/files/99-displaylink.rules" "$DESTDIR/usr/lib/udev/rules.d/99-displaylink.rules"
install -Dm755 "$SRCDIR/files/udev.sh" "$DESTDIR/opt/displaylink/udev.sh"
install -Dm644 "$SRCDIR/files/displaylink.service" "$DESTDIR/usr/lib/systemd/system/displaylink.service"
install -Dm755 "$SRCDIR/files/displaylink-sleep.sh" "$DESTDIR/usr/lib/systemd/system-sleep/displaylink.sh"
