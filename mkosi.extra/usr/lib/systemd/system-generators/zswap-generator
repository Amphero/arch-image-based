#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Swap behind zswap as GNOME OS sets it up, ported from its
# zswap-generator (gnome-build-meta, files/zswap-generator/main.rs):
# - nothing without zswap, and its sysctl tuning is masked as well
# - nothing when / is not on disk (live and installer run from RAM)
# - a oneshot service creates the sparse file and its loop device, a
#   .swap unit on the file's label enables it with discard
# The units are only generated when they can work, so the .swap unit
# never waits for a device that will not come.
set -eu

dir=${1:?}

mask_sysctl() {
    mkdir -p /run/sysctl.d
    ln -sfn /dev/null /run/sysctl.d/50-zswap.conf
}

if [ "$(cat /sys/module/zswap/parameters/enabled 2>/dev/null)" != Y ]; then
    mask_sysctl
    exit 0
fi

if [ "$(findmnt -no FSTYPE / 2>/dev/null)" != btrfs ]; then
    mask_sysctl
    exit 0
fi

# Ordered after / only, not after local-fs.target: tmp.mount is ordered
# After=swap.target, so local-fs.target -> swap file -> swap.target ->
# tmp.mount -> local-fs.target would be a cycle. systemd breaks it by
# dropping tmp.mount, /tmp is then mounted late over /tmp/.X11-unix and
# gnome-shell aborts on login.
cat >"$dir/swapfile-setup.service" <<UNIT
# Automatically generated by zswap-generator
[Unit]
Description=Sparse Swap File for zswap
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target
After=systemd-udev-trigger.service
RequiresMountsFor=/

[Service]
Type=oneshot
RemainAfterExit=yes
# GNOME OS: the loop device is attached and detached several times in a
# row while udev processes the cold plug events, wait for that first.
ExecStart=udevadm settle
ExecStart=/usr/lib/arch-image-based/swapfile create
ExecStop=/usr/lib/arch-image-based/swapfile remove
UNIT

swap='dev-disk-by\x2dlabel-swapfile.swap'
cat >"$dir/$swap" <<UNIT
# Automatically generated by zswap-generator
[Unit]
Description=Sparse Swap File for zswap
Wants=swapfile-setup.service
After=swapfile-setup.service dev-disk-by\\x2dlabel-swapfile.device
BindsTo=dev-disk-by\\x2dlabel-swapfile.device

[Swap]
What=/dev/disk/by-label/swapfile
Options=discard
UNIT

mkdir -p "$dir/swap.target.wants"
ln -sfn "../$swap" "$dir/swap.target.wants/$swap"
