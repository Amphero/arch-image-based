# Applies the user unit presets (systemctl preset-all --global) on the
# first boot and after an image update that changed them, see
# /usr/lib/arch-image-based/preset-global.
[Unit]
ConditionPathIsReadWrite=/etc
RequiresMountsFor=/var/lib

DefaultDependencies=no

Before=basic.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/arch-image-based/preset-global

[Install]
WantedBy=basic.target
