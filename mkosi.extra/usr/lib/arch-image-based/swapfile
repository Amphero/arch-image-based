#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Creates and removes the sparse swap file behind zswap, called by
# swapfile-setup.service from zswap-generator. As in GNOME OS: a file of
# four times the RAM on the encrypted root, attached to a loop device
# because swapon refuses files with holes. The .swap unit enables it
# with discard, so pages that are freed again are punched out of the
# file: on disk it only takes what was written back. Recreated on every
# boot, nothing in it survives a reboot anyway.
set -euo pipefail

file=/swap/swapfile

case "${1:-}" in
create)
    [ -d /swap ] || btrfs subvolume create /swap
    # removed first, so that a file from before loses its attributes too
    rm -f "$file"
    install -m 0600 /dev/null "$file"
    chattr +C "$file"          # no copy on write, before the first byte
    ram_kib=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
    truncate -s $((ram_kib * 1024 * 4)) "$file"
    # mkswap warns about the holes, the loop device hides them from swapon
    mkswap --label swapfile "$file" >/dev/null 2>&1
    losetup --find "$file"
    ;;
remove)
    for dev in $(losetup --list --noheadings --output NAME --associated "$file" 2>/dev/null); do
        losetup --detach "$dev"
    done
    rm -f "$file"
    ;;
*)
    echo "usage: swapfile create|remove" >&2
    exit 1
    ;;
esac
