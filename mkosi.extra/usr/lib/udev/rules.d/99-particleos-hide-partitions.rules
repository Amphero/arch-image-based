# Hide the image's own partitions from udisks so the file manager does
# not offer them as drives. Matched by the discoverable partitions spec
# type GUIDs, which removable media does not use, so external drives
# stay visible. Only the udisks layer is affected, lsblk and friends
# still see everything.

# usr, usr-verity, usr-verity-sig (x86-64), both A/B slots
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="8484680c-9521-48c6-9c11-b0720656f69e", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="77ff5f63-e7b6-4633-acf4-1565b864c0e6", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="e7bb33fb-06cf-4e81-8273-e543b413e2e2", ENV{UDISKS_IGNORE}="1"
# esp
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b", ENV{UDISKS_IGNORE}="1"
# root (x86-64)
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="4f68bce3-e8cd-4db1-96e7-fbcaf984b709", ENV{UDISKS_IGNORE}="1"
# swap
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="0657fd6d-a4ab-43c4-84e5-0933c84b4f4f", ENV{UDISKS_IGNORE}="1"
# home
SUBSYSTEM=="block", ENV{ID_PART_ENTRY_TYPE}=="933ac7e1-2eb4-4f13-b844-b9b401c60d0e", ENV{UDISKS_IGNORE}="1"

# The verity and crypt targets of those partitions carry no partition
# type, match them by the name dissect gives them. Same for the loop
# devices backing homed's per user images.
SUBSYSTEM=="block", ENV{DM_NAME}=="usr", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{DM_NAME}=="root", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{DM_NAME}=="swap", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{DM_NAME}=="home-*", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ATTR{loop/backing_file}=="*.home", ENV{UDISKS_IGNORE}="1"
